# Meson fallback downloads generated while configuring optional font features.
# wrap 检出（`[wrap-git]`）是未跟踪工作树：忽略它，但 SDK 打包会显式收集其源码与许可证
# 历史 raylib 检出：已退役，不参与构建或 SDK，保留忽略以便旧工作区升级。
/subprojects/raylib/
/subprojects/spdlog/
/subprojects/box2d/
/subprojects/utf8proc/
/subprojects/tomlplusplus/
/subprojects/freetype/
/subprojects/harfbuzz/
/subprojects/fribidi/
/subprojects/Catch2/
/subprojects/nlohmann_json/
# （见 tools/sdk_bundle.py 的 dependencies 部分与 docs/references/dependency_policy.md §6）。
/subprojects/SDL3/
/subprojects/packagecache/
/subprojects/libpng-*/
/subprojects/libpng.wrap
/subprojects/tomlplusplus-*/
/dist/

# 项目用来简单测试的目录，不需要被追踪，里面的内容可能会被随意修改。
/playground/

# 跨平台探测（probe/cross_platform）只追踪源码：SDL 源码树与构建产物现取/现建。
# 构建目录按 README 约定放在 /playground/ 下，这里再兜一层，避免误提交。
/probe/cross_platform/web/SDL/
/probe/cross_platform/**/build/

# 本地产物：DSH 会话临时目录（构建日志等），不随仓库分发
/.dsh/
